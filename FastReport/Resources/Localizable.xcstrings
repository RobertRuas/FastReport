    "home.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Separe e organize fotos no Finder para relatórios futuros."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sort and organize photos in Finder for future reports."
          }
        }
      }
