    "home.organize.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie um projeto a partir de um mapa, importe as fotos do dia e classifique-as com o teclado."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a project from a map, import the day’s photos, and sort them with the keyboard."
          }
        }
      }
    },
